# An example LLM feature group. Rename to outcome.yaml to enable it.
group: outcome
description: Whether the task got done, and how smoothly the collaboration went.
evidence: true
guidance: |
  Judge the user's satisfaction only from what the user wrote, not from the assistant's
  own claims about its work.
features:
  - name: task_type
    type: category
    description: The main kind of work the user asked for.
    labels:
      bugfix: Fixing a defect in existing code or configuration.
      feature: Building something new.
      analysis: Understanding, reviewing or explaining existing material.
      writing: Producing prose such as docs or papers.
      ops: Running, deploying or operating systems.
      other: None of the above.
  - name: task_completed
    type: boolean
    description: The user's request was fulfilled by the end of the trajectory.
  - name: user_frustration
    type: scalar
    range: [0, 1]
    thresholds: {high: 0.6}
    description: How much dissatisfaction the user expressed toward the assistant; 0 is none.
  - name: frustration_curve
    type: vector
    per: chunk
    range: [0, 1]
    description: user_frustration judged separately within each chunk.
  - name: failure_modes
    type: set
    description: Problems in the assistant's behaviour that the trajectory shows.
    labels:
      misread_request: Did something other than what was asked.
      repeated_failure: Retried the same failing approach several times.
      premature_claim: Claimed success without verifying.
      overreach: Changed things beyond the request.
      stalled: Stopped or asked the user when it could have continued.
